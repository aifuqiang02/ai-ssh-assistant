{
  "name": "@ai-ssh/server",
  "version": "1.8.27",
  "description": "AI SSH Assistant Server API",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore=node_modules/** src/index.ts",
    "dev:clean": "rimraf node_modules/.tsx && tsx watch --clear-screen=false src/index.ts",
    "dev:debug": "node scripts/clean-ports.js && tsx watch --inspect=9229 --clear-screen=false src/index.ts",
    "debug": "node --inspect --import tsx/esm src/index.ts",
    "build": "tsc --build --force && tsc-alias",
    "build:bundle": "node build.config.mjs",
    "start": "node dist/index.js",
    "start:bundle": "node dist-bundle/index.js",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts --fix --no-eslintrc --config .eslintrc.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist dist-bundle"
  },
  "dependencies": {
    "@ai-ssh/database": "workspace:*",
    "@ai-ssh/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.9.1",
    "@fastify/cors": "^8.4.0",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^9.0.1",
    "@fastify/static": "^6.12.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@prisma/client": "5.7.0",
    "bcryptjs": "^2.4.3",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.2",
    "fastify": "^4.24.3",
    "fs-extra": "^11.2.0",
    "i18next": "^25.6.0",
    "i18next-fs-backend": "^2.6.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "minio": "^8.0.6",
    "node-cron": "^3.0.3",
    "openai": "^4.20.1",
    "pino": "^9.12.0",
    "pino-pretty": "^13.1.1",
    "rotating-file-stream": "^3.2.1",
    "sharp": "^0.33.0",
    "ssh2": "^1.15.0",
    "vite-plugin-vue-inspector-ai": "^1.0.31",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/ssh2": "^1.11.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.54.0",
    "supertest": "^6.3.3",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
