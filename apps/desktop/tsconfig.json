{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ai-ssh/shared/*": ["../../packages/shared/src/*"],
      "@ai-ssh/core/*": ["../../packages/core/src/*"]
    },
    "types": ["electron", "node"],
    "lib": ["DOM", "ES2020", "ESNext"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*", "electron/**/*", "*.config.*", "src/global.d.ts"],
  "exclude": ["node_modules", "dist", "dist-electron", "release"]
}
