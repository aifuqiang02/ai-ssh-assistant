  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.provider-icon-wrapper i {
  font-size: 24px;
  color: #ffffff;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
}

.provider-details {
  flex: 1;
  min-width: 0;
}

.provider-name {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  color: var(--vscode-fg);
}

.provider-description {
  margin: 4px 0 0 0;
  font-size: 13px;
  color: var(--vscode-fg-muted);
}

.provider-actions {
  display: flex;
